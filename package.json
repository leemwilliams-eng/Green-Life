{
  "name": "green-life",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --offline --max-workers 1 --go",
    "start:go": "expo start --offline --max-workers 1 --go",
    "start:go:online": "expo start --go",
    "start:dev-client": "expo start --offline --max-workers 1",
    "start:dev-client:online": "expo start",
    "start:native": "expo start --offline --max-workers 1",
    "start:native:online": "expo start",
    "android": "set \"JAVA_HOME=C:\\Program Files\\Android\\Android Studio\\jbr\" && set \"PATH=%JAVA_HOME%\\bin;%PATH%\" && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.7",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~54.0.0",
    "expo-av": "~15.0.0",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-speech": "~13.0.0",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
